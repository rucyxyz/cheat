{
  "name": "cheat",
  "version": "1.0.0",
  "description": "Standalone settings panel for the cheat",
  "main": "main.js",
  "author": "your-name <you@example.com>",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.yourname.cheat",
    "productName": "cheat",
    "artifactName": "cheat-${version}-win-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
