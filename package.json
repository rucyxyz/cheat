{
  "name": "cheat",
  "version": "1.0.0",
  "description": "Electron settings panel with aimbot / ESP / visuals tabs, configs and mod loading",
  "main": "main.js",
  "author": "rucyxyz",
  "license": "MIT",
  "homepage": "https://github.com/rucyxyz/cheat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rucyxyz/cheat.git"
  },
  "bugs": {
    "url": "https://github.com/rucyxyz/cheat/issues"
  },
  "keywords": [
    "electron",
    "cheat",
    "settings-ui",
    "overlay",
    "aimware"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.rucyxyz.cheat",
    "productName": "cheat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "cheat-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "cheat-${version}-win-${arch}-portable.${ext}"
    }
  }
}
