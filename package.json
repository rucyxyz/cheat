{
  "name": "cheat",
  "version": "1.0.0",
  "description": "External Valorant overlay and settings panel",
  "main": "main.js",
  "author": "rucyxyz",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "koffi": "^2.9.2"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.rucyxyz.cheat",
    "productName": "cheat",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "game.js", "offsets.js", "renderer/**/*"],
    "asarUnpack": ["**/node_modules/koffi/**"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "cheat-${version}-win-${arch}-setup.${ext}"
    },
    "portable": { "artifactName": "cheat-${version}-win-${arch}-portable.${ext}" }
  }
}
